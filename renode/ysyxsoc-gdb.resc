using sysbus

$gdb_port?=3333

mach create "ysyxsoc"
machine LoadPlatformDescription @ysyxsoc-rv32e.repl

# Load the raw flash image at the ysyxSoC flash base. The bootloader copies
# runtime sections to their VMA locations, so do not pre-load .text/.data into
# SDRAM here.
macro reload
"""
    sysbus LoadBinary $flash_image 0x30000000
    cpu PC 0x30000000
"""

# Fast path: use this from the Renode monitor after the CPU faults and the GDB
# server exits. This does not reload the ELF, so it avoids the slow LoadELF
# path for large images.
#
#   runMacro $restart_gdb
#
macro restart_gdb
"""
    pause
    machine StopGdbServer
    cpu Reset
    cpu PC 0x30000000
    machine StartGdbServer $gdb_port
"""

# Full path: reload the flash image too if memory contents must be restored.
#
macro reload_gdb
"""
    pause
    machine StopGdbServer
    runMacro $reload
    machine StartGdbServer $gdb_port
"""

runMacro $reload
machine StartGdbServer $gdb_port
