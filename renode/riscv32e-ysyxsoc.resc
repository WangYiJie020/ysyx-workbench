using sysbus

$gdb_port?=3333

mach create "riscv32e-ysyxsoc"
machine LoadPlatformDescription @riscv32e-ysyxsoc.repl
machine LoadPlatformDescription @uart.repl
machine LoadPlatformDescription @clint.repl

# Load the raw flash image at the ysyxSoC flash base. The bootloader copies
# runtime sections to their VMA locations, so do not pre-load .text/.data into
# SDRAM here.
macro reload
"""
    sysbus LoadBinary $image 0x30000000
    cpu PC 0x30000000
"""

macro restart_gdb
"""
    pause
    machine StopGdbServer
    cpu Reset
    cpu PC 0x30000000
    machine StartGdbServer $gdb_port
"""

macro reload_gdb
"""
    pause
    machine StopGdbServer
    runMacro $reload
    machine StartGdbServer $gdb_port
"""

runMacro $reload
machine StartGdbServer $gdb_port
