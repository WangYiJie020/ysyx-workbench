mrom: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x00001000

sram: Memory.MappedMemory @ sysbus 0x0f000000
    size: 0x00002000

flash: Memory.MappedMemory @ sysbus 0x30000000
    size: 0x01000000

psram: Memory.MappedMemory @ sysbus 0x80000000
    size: 0x00400000

sdram: Memory.MappedMemory @ sysbus 0xa0000000
    size: 0x02000000

cpu: CPU.RiscV32 @ sysbus
    cpuType: "rv32e_zicsr_zifencei"
    privilegedArchitecture: PrivilegedArchitecture.Priv1_10
    timeProvider: empty
    hartId: 0
    reset:
        PC 0x30000000
